{
  "name": "heiss-ui",
  "version": "0.6.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tristmeister/HEISS-UI.git"
  },
  "bugs": {
    "url": "https://github.com/tristmeister/HEISS-UI/issues"
  },
  "homepage": "https://tristmeister.github.io/HEISS-UI/",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/ensure-runtime-dependencies.mjs --dev",
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"node server/index.js\"",
    "predev:demo": "node scripts/ensure-runtime-dependencies.mjs --dev",
    "dev:demo": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"node -e \\\"process.env.HEISS_DEMO='1';import('./server/index.js')\\\"\"",
    "predev:lan": "node scripts/ensure-runtime-dependencies.mjs --dev",
    "dev:lan": "concurrently \"vite --host 0.0.0.0 --port 5173\" \"node -e \\\"process.env.HOST='0.0.0.0';process.env.HEISS_ALLOW_LAN='1';import('./server/index.js')\\\"\"",
    "prestart": "node scripts/ensure-runtime-dependencies.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test server/*.test.js scripts/*.test.js",
    "release": "node scripts/release.mjs",
    "check:updates": "npm outdated",
    "package": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "img-fx": "^0.5.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
