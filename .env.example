COMFY_URL=http://127.0.0.1:8188
HOST=127.0.0.1
PORT=8787
JAI_DATA_DIR=./data
COMFY_OUTPUT_DIR=
# LAN Bridge generates its own certificates and listeners when you enable it in
# Settings -> Privacy. Uncomment only to move them off the default ports.
# JAI_BRIDGE_PORT=8788
# JAI_BRIDGE_SETUP_PORT=8789
# Optional: serve the whole app over a certificate you already manage, instead of
# the desktop bridge. Must cover your LAN address and be trusted on receivers.
# JAI_TLS_CERT=/absolute/path/to/lan-cert.pem
# JAI_TLS_KEY=/absolute/path/to/lan-key.pem
